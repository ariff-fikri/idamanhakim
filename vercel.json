{
    "framework": null,
    "buildCommand": "echo \"No frontend build required\"",
    "installCommand": "echo \"Composer handled by vercel-php runtime\"",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/api/index.php" }
    ]
}
